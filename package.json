{
  "name": "doreumi-desktop-pet",
  "version": "0.1.0",
  "private": true,
  "description": "Private handoff repository for finishing the Doreumi Windows desktop pet",
  "type": "module",
  "main": "deliverable/dorms-v98-badge-integration/desktop.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preview": "node deliverable/dorms-v98-badge-integration/serve.mjs",
    "desktop:install": "install-electron",
    "desktop": "npm run desktop:install && electron deliverable/dorms-v98-badge-integration/desktop.cjs",
    "test": "node scripts/verify-handoff-assets.mjs && node scripts/run-tests.mjs",
    "qa:install-browser": "playwright install chromium",
    "qa": "node scripts/run-v98.mjs qa",
    "qa:motion": "node scripts/run-v98.mjs qa:motion",
    "qa:desktop": "npm run desktop:install && node scripts/run-v98.mjs qa:desktop"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "playwright": "1.62.1"
  }
}
